name: "bge-reranker"
backend: "python"
max_batch_size: 32

input [
  {
    name: "query"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "passage"
    data_type: TYPE_STRING
    dims: [1]
  }
]

output [
  {
    name: "score"
    data_type: TYPE_FP32
    dims: [1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
