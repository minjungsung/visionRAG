name: "qwen2-vl"
backend: "python"
max_batch_size: 1

input [
  {
    name: "prompt"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [-1]
  }
]

output [
  {
    name: "response"
    data_type: TYPE_STRING
    dims: [1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
